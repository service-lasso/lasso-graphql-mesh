{
  "id": "graphql-mesh",
  "name": "GraphQL Mesh Gateway",
  "description": "Pinned GraphQL Mesh Compose and Hive Gateway runtime for a locally composed supergraph.",
  "enabled": true,
  "version": "0.1.0",
  "logoutput": true,
  "icon": [
    {
      "provider": "lucide",
      "name": "git-merge"
    }
  ],
  "servicetype": 50,
  "servicelocation": 10,
  "logo": [],
  "logs": {
    "default": {
      "path": "logs/graphql-mesh.log"
    }
  },
  "meta": {
    "developers": [
      {
        "name": "Service Lasso contributors"
      }
    ],
    "license": "Apache-2.0",
    "repository": {
      "type": "git",
      "url": "https://github.com/service-lasso/lasso-graphql-mesh.git"
    },
    "websiteUrl": "https://the-guild.dev/graphql/mesh",
    "documentationUrl": "https://github.com/service-lasso/lasso-graphql-mesh/blob/develop/README.md",
    "issuesUrl": "https://github.com/service-lasso/lasso-graphql-mesh/issues",
    "support": {
      "issuesUrl": "https://github.com/service-lasso/lasso-graphql-mesh/issues"
    },
    "links": {
      "repository": "https://github.com/service-lasso/lasso-graphql-mesh",
      "issues": "https://github.com/service-lasso/lasso-graphql-mesh/issues",
      "documentation": "https://github.com/service-lasso/lasso-graphql-mesh/blob/develop/README.md"
    },
    "tags": [
      "service-lasso",
      "graphql",
      "graphql-mesh",
      "hive-gateway"
    ]
  },
  "artifact": {
    "kind": "archive",
    "source": {
      "type": "github-release",
      "repo": "service-lasso/lasso-graphql-mesh",
      "channel": "latest"
    },
    "platforms": {
      "win32": {
        "assetName": "graphql-mesh-win32.zip",
        "archiveType": "zip",
        "command": "./runtime/start.mjs",
        "args": [],
        "checksum": { "algorithm": "sha256", "assetName": "SHA256SUMS.txt" }
      },
      "darwin": {
        "assetName": "graphql-mesh-darwin.tar.gz",
        "archiveType": "tar.gz",
        "command": "./runtime/start.mjs",
        "args": [],
        "checksum": { "algorithm": "sha256", "assetName": "SHA256SUMS.txt" }
      },
      "linux": {
        "assetName": "graphql-mesh-linux.tar.gz",
        "archiveType": "tar.gz",
        "command": "./runtime/start.mjs",
        "args": [],
        "checksum": { "algorithm": "sha256", "assetName": "SHA256SUMS.txt" }
      },
      "default": {
        "assetName": "graphql-mesh-win32.zip",
        "archiveType": "zip",
        "command": "./runtime/start.mjs",
        "args": [],
        "checksum": { "algorithm": "sha256", "assetName": "SHA256SUMS.txt" }
      }
    }
  },
  "actions": {
    "install": {
      "description": "Acquire the pinned GraphQL Mesh Compose and Hive Gateway artifact.",
      "mode": "converge-install",
      "idempotent": true
    },
    "config": {
      "description": "Prepare local GraphQL Mesh configuration without embedding subgraph credentials.",
      "mode": "converge-config",
      "idempotent": true
    },
    "update": {
      "description": "Apply a newer release artifact and reconcile configuration before restart.",
      "mode": "converge-update",
      "idempotent": true
    },
    "start": {
      "description": "Start Hive Gateway with an already composed local supergraph.",
      "mode": "runtime-start",
      "idempotent": true
    },
    "stop": {
      "description": "Stop the GraphQL Mesh gateway gracefully.",
      "mode": "runtime-stop",
      "idempotent": true
    },
    "restart": {
      "description": "Restart the sample echo service after config or update changes.",
      "mode": "runtime-restart",
      "idempotent": false
    },
    "rollback": {
      "description": "Restore the previously deployed artifact if an update fails validation.",
      "mode": "state-rollback",
      "idempotent": false
    }
  },
  "execconfig": {
    "serviceorder": 100,
    "serviceport": 4000,
    "execcwd": ".",
    "executable": "node",
    "args": [
      "runtime/start.mjs"
    ],
    "env": {
      "GRAPHQL_MESH_HOST": "127.0.0.1",
      "GRAPHQL_MESH_PORT": "4000",
      "GRAPHQL_MESH_ENDPOINT": "/graphql"
    },
    "depend_on": ["@node"]
  },
  "healthchecks": [
    {
      "id": "process-ready",
      "type": "process"
    }
  ]
}
